# ==============================================================================
# super-work Environment Configuration (All Optional)
# 所有环境变量均为可选：模型配置池与密钥推荐直接在 Web「设置 → 大模型与角色」中管理
# ==============================================================================

# --- Control-Plane LLM Seed (falls back to built-in HeuristicControlLLM if unset) ---
# 控制面大模型初始种子（未设置且未在 Web 配置时，默认启用零消耗本地启发式路由）

# DeepSeek API (default base URL: https://api.deepseek.com/v1, model: deepseek-chat)
# DEEPSEEK_API_KEY=

# OpenAI API (default base URL: https://api.openai.com/v1, model: gpt-4o-mini)
# OPENAI_API_KEY=

# Custom OpenAI-compatible Control-Plane override / 自定义 OpenAI 兼容控制面覆盖
# SUPER_WORK_LLM_API_KEY=
# SUPER_WORK_LLM_BASE_URL=https://api.deepseek.com/v1
# SUPER_WORK_LLM_MODEL=deepseek-chat

# Allow falling back to tool-less local claude/codex CLI when no API key is set (0 or 1)
# 无 API Key 时是否允许控制面降级复用无工具模式的本机 claude/codex CLI（0 或 1）
# SUPER_WORK_ENABLE_CLI_LLM=0

# --- Storage & Network / 存储目录与监听网络 ---

# Runtime directory for SQLite WAL DB, Spill artifacts, backups, and git worktrees
# 运行时 SQLite WAL 状态库、Spill 产物、热备份与隔离 git worktree 存储目录
# SUPER_WORK_DATA_DIR=./.super-work

# Daemon bind host & port (non-loopback HOST requires SUPER_WORK_TOKEN)
# 守护进程监听地址与端口（绑定非 127.0.0.1 地址时强制要求配置 SUPER_WORK_TOKEN）
# HOST=127.0.0.1
# PORT=4318

# --- Security & Inbound Webhooks / 接口鉴权与 Webhook 签名 ---

# Optional Bearer / ?token= secret protecting all /api/* REST, MCP, and SSE routes
# 可选鉴权令牌：启用后保护所有 /api/* REST、MCP 与 SSE 端点（HMAC 验签的 /api/webhooks/* 除外）
# SUPER_WORK_TOKEN=

# HMAC-SHA256 secret for GitHub inbound webhooks (POST /api/webhooks/github)
# GitHub 入站 Webhook 验签密钥（X-Hub-Signature-256）
# GITHUB_WEBHOOK_SECRET=

# HMAC secret signing mobile approval cards (/api/webhooks/action) & ChatOps callbacks
# 移动端一键审批卡片签名与 ChatOps 回调验签密钥（X-Super-Work-Signature）
# SUPER_WORK_ACTION_SECRET=
