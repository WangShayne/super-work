# Optional Control-Plane LLM Configuration (falls back to built-in heuristic mode if unset)
# 可选控制面模型配置（未设置时默认使用内置启发式评估模式）

# DeepSeek API (default endpoint: https://api.deepseek.com/v1, model: deepseek-chat)
# DEEPSEEK_API_KEY=

# OpenAI API (default endpoint: https://api.openai.com/v1, model: gpt-4o-mini)
# OPENAI_API_KEY=

# Generic OpenAI-compatible override / 通用 OpenAI 兼容接口覆盖配置
# SUPER_WORK_LLM_API_KEY=
# SUPER_WORK_LLM_BASE_URL=https://api.deepseek.com/v1
# SUPER_WORK_LLM_MODEL=deepseek-chat

# Allow falling back to tool-less local claude/codex CLI when no API key is configured (0 or 1)
# 无 API Key 时是否允许降级调用无工具模式的本地 claude/codex CLI（0 或 1）
# SUPER_WORK_ENABLE_CLI_LLM=0

# Runtime data directory for SQLite WAL DB, Spill artifacts, and git worktrees
# 运行时 SQLite WAL 状态库、Spill 产物与 git worktree 存储目录
# SUPER_WORK_DATA_DIR=./.super-work

# Daemon HTTP/SSE port / 守护服务监听端口
# PORT=4318
